\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{kazetex-pagestyle}[2026/05/18 KazeTeX page layout, headers, and cover]

% ---- tikz for decorative elements ----
\RequirePackage{tikz}

% ---- colors are defined in kazetex.cls ----

% ---- safety fallback for \if@kazetex@pad (defined in kazetex.cls) ----
\@ifundefined{if@kazetex@pad}{\newif\if@kazetex@pad\@kazetex@padfalse}{}

% ---- \KazeTeX logo ----
% Follows \LaTeX structure: A/E small+raised, T lowered, no letter overlap
\DeclareRobustCommand{\KazeTeX}{%
  K%
  \raisebox{0.45ex}{\scalebox{0.72}{A}}%
  Z%
  E%
  \raisebox{-0.45ex}{T}%
  \raisebox{0.45ex}{\scalebox{0.72}{E}}%
  X%
}

% ---- page geometry ----
\if@kazetex@pad
  \geometry{
    papersize={24cm,18cm},
    left=2.2cm,
    right=2.2cm,
    top=1.8cm,
    bottom=1.8cm,
    headheight=1.5cm,
  }
  \raggedbottom
\else
  \geometry{
    paper=a4paper,
    left=2.5cm,
    right=2.5cm,
    top=3cm,
    bottom=2.5cm,
    headheight=1.2cm,
  }
\fi

% ---- fancyhdr headers/footers ----
\fancypagestyle{kazeheadings}{%
  \fancyhf{}
  \if@kazetex@pad
    \fancyhead[L]{%
      \colorbox{kazenavy}{%
        \makebox[0.32\textwidth][l]{%
          \color{white}\bfseries\small\;\leftmark\;%
        }%
      }%
    }
    \fancyhead[R]{\small\color{kazenavy}\thepage}
    \fancyfoot[C]{\color{kazegray}\rule{0.25\textwidth}{0.4pt}\\\vspace{2pt}\footnotesize\color{kazegray}\KazeTeX\ 刷题本}
    \fancyfoot[R]{\footnotesize\color{kazeteal}\hyperlink{kaze:toc}{☰\ 目录}}
  \else
    \fancyhead[L]{%
      \colorbox{kazenavy}{%
        \makebox[0.35\textwidth][l]{%
          \color{white}\bfseries\small\;\leftmark\;%
        }%
      }%
    }
    \fancyhead[R]{\small\color{kazenavy}\thepage}
    \fancyfoot[C]{\color{kazegray}\rule{0.2\textwidth}{0.4pt}}
  \fi
}

% ---- metadata commands ----
\def\@problemrange{}
\newcommand{\problemrange}[1]{\def\@problemrange{#1}}
\def\@problemcount{}
\newcommand{\problemcount}[1]{\def\@problemcount{#1}}

% ---- cover page ----
% Left-right split layout for both modes.
% Left: navy band with \KazeTeX branding + decorative formula watermarks.
% Right: \title (primary), \author, \date.
\renewcommand{\maketitle}{%
  \begin{titlepage}
    \thispagestyle{empty}
    \if@kazetex@pad
      % ----- PAD landscape cover (24cm×18cm) -----
      \begin{tikzpicture}[remember picture, overlay]
        % navy band on left
        \fill[kazenavy] (current page.north west) rectangle ([xshift=7cm]current page.south west);
        % decorative formula watermarks on navy band
        \node[scale=1.2, color=kazenavy!25!white, rotate=10]
          at ([shift={(3cm,-0.12\paperheight)}]current page.north west)
          {$\displaystyle\lim_{x\to 0}\frac{\sin x}{x}=1$};
        \node[scale=0.9, color=kazenavy!25!white, rotate=-8]
          at ([shift={(4.5cm,-0.65\paperheight)}]current page.north west)
          {$\displaystyle\int_a^b f(x)\,\mathrm{d}x$};
        \node[scale=1.0, color=kazenavy!25!white, rotate=15]
          at ([shift={(2cm,-0.88\paperheight)}]current page.north west)
          {$\mathrm{e}^{\mathrm{i}\pi}+1=0$};
        % KazeTeX logo centered on navy band
        \node[white, scale=1.6] at ([shift={(3.5cm,-0.42\paperheight)}]current page.north west) {\KazeTeX};
        % separator line
        \draw[white, line width=0.5pt] ([shift={(7.3cm,0)}]current page.north west) -- ([shift={(7.3cm,0)}]current page.south west);
        % right side decorative accent
        \fill[kazenavy!10] (current page.north east) rectangle ([shift={(-1cm,-0.06\paperheight)}]current page.north east);
        \node[scale=0.7, color=kazenavy!15, rotate=-5] at ([shift={(-4cm,-0.9\paperheight)}]current page.south east)
          {$\displaystyle\sum_{n=1}^{\infty}\frac{1}{n^2}=\frac{\pi^2}{6}$};
        % right side: title + author + date (aligned with logo)
        \node[anchor=west, text width=8.5cm, align=flush left] at ([shift={(8.5cm,-0.42\paperheight)}]current page.north west) {%
          \ifx\@title\@empty\else{\Huge\bfseries\color{kazenavy}\@title}\\[0.6cm]\fi
          \ifx\@author\@empty\else{\Large\@author}\\[0.3cm]\fi
          \ifx\@date\@empty\else{\large\color{kazegray}\@date}\fi
        };
      \end{tikzpicture}
    \else
      % ----- A4 portrait cover -----
      \begin{tikzpicture}[remember picture, overlay]
        % navy band on left (40% of page width)
        \fill[kazenavy] (current page.north west) rectangle ([xshift=0.4\paperwidth]current page.south west);
        % decorative formula watermarks on navy band
        \node[scale=1.4, color=kazenavy!22!white, rotate=12]
          at ([shift={(0.14\paperwidth,-0.16\paperheight)}]current page.north west)
          {$\displaystyle\lim_{x\to 0}\frac{\sin x}{x}=1$};
        \node[scale=1.1, color=kazenavy!22!white, rotate=-6]
          at ([shift={(0.26\paperwidth,-0.36\paperheight)}]current page.north west)
          {$\displaystyle\int_a^b f(x)\,\mathrm{d}x$};
        \node[scale=1.0, color=kazenavy!22!white, rotate=8]
          at ([shift={(0.1\paperwidth,-0.64\paperheight)}]current page.north west)
          {$\mathrm{e}^{\mathrm{i}\pi}+1=0$};
        \node[scale=0.9, color=kazenavy!22!white, rotate=-10]
          at ([shift={(0.24\paperwidth,-0.84\paperheight)}]current page.north west)
          {$\displaystyle\sum_{n=1}^{\infty}\frac{1}{n^2}=\frac{\pi^2}{6}$};
        % KazeTeX logo centered on navy band
        \node[white, scale=2.0] at ([shift={(0.2\paperwidth,-0.45\paperheight)}]current page.north west) {\KazeTeX};
        % right side decorative accent (top corner)
        \fill[kazenavy!8] (current page.north east) rectangle ([shift={(-2cm,-0.05\paperheight)}]current page.north east);
        \node[scale=0.8, color=kazenavy!12, rotate=6] at ([shift={(-3.5cm,-0.92\paperheight)}]current page.south east)
          {$\displaystyle\frac{\mathrm{d}}{\mathrm{d}x}\mathrm{e}^x=\mathrm{e}^x$};
        % right side: title + author + date (aligned with logo)
        \node[anchor=west, text width=0.52\paperwidth, align=flush left] at ([shift={(0.45\paperwidth,-0.45\paperheight)}]current page.north west) {%
          \ifx\@title\@empty\else{\Huge\bfseries\color{kazenavy}\@title}\\[0.6cm]\fi
          \ifx\@author\@empty\else{\Large\@author}\\[0.3cm]\fi
          \ifx\@date\@empty\else{\large\color{kazegray}\@date}\fi
        };
      \end{tikzpicture}
    \fi
  \end{titlepage}
}

% ---- hyperlinks ----
\hypersetup{
  colorlinks=true,
  linkcolor=kazeteal,
  urlcolor=kazeteal,
}

% ---- table of contents anchor for pad navigation ----
\AddToHook{cmd/tableofcontents/before}{\hypertarget{kaze:toc}{}}

% ---- section/subsection styling ----
% \clearpage before each \section (top-level divider)
\AddToHook{cmd/section/before}{\clearpage}

% section is now top-level (no chapter); more prominent with rule below
\titleformat{\section}
  {\LARGE\bfseries\color{kazenavy}}
  {\thesection}{1em}{}
  [\vspace{-0.2cm}\textcolor{kazenavy}{\rule{\textwidth}{1.5pt}}\vspace{0.5cm}]

\titleformat{\subsection}
  {\Large\bfseries\color{kazenavy!80}}
  {\thesubsection}{1em}{}
